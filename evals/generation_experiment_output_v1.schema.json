{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "generation_experiment_output_v1.schema.json",
  "title": "Generation experiment output v1",
  "type": "object",
  "required": ["schema_version", "experiment_id", "records"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "experiment_id": {"type": "string", "minLength": 1},
    "records": {"type": "array", "items": {"$ref": "#/$defs/record"}}
  },
  "additionalProperties": false,
  "$defs": {
    "source_ref": {
      "type": "object",
      "required": ["source_file", "source_page"],
      "properties": {
        "source_file": {"type": "string"}, "source_page": {"type": "integer", "minimum": 1},
        "chunk_id": {"type": "string"}, "rank": {"type": "integer", "minimum": 1},
        "evidence_unit_ids": {"type": "array", "items": {"type": "string"}}
      }, "additionalProperties": false
    },
    "record": {
      "type": "object",
      "required": ["question_id", "experiment_arm", "question", "context", "model_identifier", "prompt_version", "answer_schema_version", "generated_answer", "rubric_reference", "correctness", "required_fact_results", "claims", "citations", "abstention", "usage", "failure", "evaluator_version"],
      "properties": {
        "question_id": {"type": "string", "pattern": "^Q[0-9]{3}$"},
        "experiment_arm": {"enum": ["oracle_context", "stage2b_end_to_end"]},
        "question": {"type": "string"},
        "context": {"type": "object", "required": ["items"], "properties": {"items": {"type": "array", "items": {"$ref": "#/$defs/source_ref"}}}, "additionalProperties": false},
        "model_identifier": {"type": "string"}, "prompt_version": {"type": "string"}, "answer_schema_version": {"type": "string"},
        "generated_answer": {"type": "string"}, "rubric_reference": {"type": "string"},
        "correctness": {"type": "object", "required": ["label", "review_method"], "properties": {"label": {"enum": ["correct", "incorrect", "uncertain", "not_applicable"]}, "review_method": {"const": "human"}, "notes": {"type": "string"}}, "additionalProperties": false},
        "required_fact_results": {"type": "array", "items": {"type": "object", "required": ["fact_index", "status", "review_method"], "properties": {"fact_index": {"type": "integer", "minimum": 0}, "status": {"enum": ["present", "absent", "contradicted", "uncertain"]}, "review_method": {"const": "human"}, "notes": {"type": "string"}}, "additionalProperties": false}},
        "claims": {"type": "array", "items": {"type": "object", "required": ["claim_id", "text", "grounding", "citation_ids", "review_method"], "properties": {"claim_id": {"type": "string"}, "text": {"type": "string"}, "grounding": {"enum": ["supported", "unsupported", "uncertain"]}, "citation_ids": {"type": "array", "items": {"type": "string"}}, "review_method": {"const": "human"}}, "additionalProperties": false}},
        "citations": {"type": "array", "items": {"type": "object", "required": ["citation_id", "claim_ids", "source_file", "source_page", "support", "review_method"], "properties": {"citation_id": {"type": "string"}, "claim_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1}, "source_file": {"type": "string"}, "source_page": {"type": "integer", "minimum": 1}, "support": {"enum": ["supported", "not_supported", "uncertain"]}, "review_method": {"const": "human"}}, "additionalProperties": false}},
        "abstention": {"type": "object", "required": ["applicable", "label", "asserted_unsupported_rule", "review_method"], "properties": {"applicable": {"type": "boolean"}, "label": {"enum": ["appropriate", "inappropriate", "uncertain", "not_applicable"]}, "asserted_unsupported_rule": {"type": "boolean"}, "review_method": {"const": "human"}}, "additionalProperties": false},
        "usage": {"type": "object", "required": ["latency_ms", "input_tokens", "output_tokens", "total_tokens", "estimated_cost_usd"], "properties": {"latency_ms": {"type": "number", "minimum": 0}, "input_tokens": {"type": "integer", "minimum": 0}, "output_tokens": {"type": "integer", "minimum": 0}, "total_tokens": {"type": "integer", "minimum": 0}, "estimated_cost_usd": {"type": "number", "minimum": 0}}, "additionalProperties": false},
        "failure": {"type": ["object", "null"], "properties": {"stage": {"type": "string"}, "error_type": {"type": "string"}, "message": {"type": "string"}}, "required": ["stage", "error_type", "message"], "additionalProperties": false},
        "evaluator_version": {"const": "generation-v1"}
      }, "additionalProperties": false
    }
  }
}
