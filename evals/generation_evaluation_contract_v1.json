    "stage2b_retrieval_configuration": "configs/stage2b_voyage_rerank3.json"
  },
  "arms": {
    "oracle_context": {
      "context_source": "authoritative source fragments referenced by the question's Evaluation Contract v2 evidence units",
      "purpose": "Measure generation when required positive evidence is supplied. Q040 instead receives its reviewed nearby clauses and remains a negative-space case."
    },
    "stage2b_end_to_end": {
      "context_source": "frozen Voyage-4 Top-30 candidates reranked by Voyage rerank-3 to Top-10",
      "purpose": "Measure the complete frozen Stage 2B retrieval plus generation path."
    }
  },
  "shared_controls": [
    "model_identifier",
    "prompt_version",
    "answer_schema_version",
    "evaluator_version"
  ],
  "scoring": {
    "correctness": "Human reviewer labels correct, incorrect, or uncertain against the expected answer and policy conclusion; fluency is irrelevant.",
    "completeness": "Human reviewer marks each existing gold required fact present, absent, or contradicted. Complete means every required fact is present.",
    "faithfulness": "Human reviewer atomizes factual policy claims and labels each supported, unsupported, or uncertain using only supplied context. Grounded-claim rate excludes no factual claims from its denominator.",
    "citation_accuracy": "The evaluator deterministically checks that a citation points to both supplied context and an authoritative source/page. A human separately labels whether the resolved evidence supports the associated claim.",
    "abstention": "Q040 is scored only under the negative-space protocol: appropriately state insufficient evidence and do not assert automatic termination. It is excluded from ordinary positive correctness, completeness, and required-fact metrics."
  },
  "human_review_required": [
    "policy-conclusion correctness",
    "semantic required-fact coverage",
    "claim atomization and contextual support",
    "citation-to-claim support",
    "Q040 abstention appropriateness"
  ],
  "deterministic_checks": [
    "schema and authoritative-reference validation",
    "citation source/page resolution",
    "derived completeness and groundedness from reviewed labels",
    "metric aggregation and paired-arm failure attribution"
  ],
  "negative_space_questions": ["Q040"],
